# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BASETEN_API_KEY: Required for Meta Muse Spark Open inference via Baseten.
# Base URL: https://inference.baseten.co/v1/chat/completions
# Model: meta-models/muse-spark-open-1026
# Configure this via server secrets. Never expose to client bundles or VITE_ vars.
BASETEN_API_KEY=""

# FIREWORKS_API_KEY: Meta Muse Spark Open on Fireworks, used for creature chat, creature banter and photo quests.
# Model: accounts/fireworks/models/muse-spark-open
# Configure this via server secrets. Never expose to client bundles or VITE_ vars.
FIREWORKS_API_KEY=""

# META_API_KEY: Meta Model API key (starts with LLM_), used for Muse Image creature artwork.
# Endpoint: https://api.meta.ai/v1/images/edits, model muse-image-1.0. MODEL_API_KEY also works.
# Configure this via server secrets. Never expose to client bundles or VITE_ vars.
META_API_KEY=""
